# Copy to .env and replace EVERY value. All values below are DUMMY placeholders for local development only.
# docker compose refuses to start if a required variable is missing (see ":?" in docker-compose.yml).
# Never commit .env. Generate real secrets with e.g.: openssl rand -base64 48

MYSQL_ROOT_PASSWORD=change-me-root-local-only
MYSQL_PASSWORD=change-me-db-local-only

# dev identity provider (HS256) - local only; production uses OIDC (OIDC_ISSUER_URI) and removes these
JWT_SECRET=change-me-min-32-bytes-local-only-0123456789
DEV_AUTH_PASSWORD=change-me-dev-login-password

# shared service credential for gateway -> control plane (use mTLS / workload identity in production)
GATEWAY_SERVICE_TOKEN=change-me-gateway-token-local-only

# seeded demo consumer key, format: <prefix>.<secret> (>= 24 chars secret). Used by scripts/smoke-test.sh
DEMO_API_KEY=kdemo.change-me-demo-key-local-only-0123456789

GRAFANA_ADMIN_PASSWORD=change-me-grafana-local-only

# observability sampling (1.0 = every trace; keep low in production to control cost)
TRACE_SAMPLING=0.5
